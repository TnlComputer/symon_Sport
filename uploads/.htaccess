# Fotos subidas por los usuarios: solo imágenes, nunca se ejecuta código acá
<FilesMatch "\.(?i:php|phtml|phar|pl|py|cgi|sh|html?|js|svg)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
# (sin -ExecCGI: el hosting no permite cambiarlo y da error 500; los scripts ya quedan bloqueados arriba)
Options -Indexes
